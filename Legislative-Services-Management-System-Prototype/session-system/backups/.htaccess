# Deny all direct web access to backup files — they contain sensitive
# session data and should only ever be reached by the server-side PHP
# scripts in this app (e.g. cron_backup.php), never by URL.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>
