# Copy to config/.env (run `php tools/setup.php` to generate one with fresh secrets).
# NEVER commit config/.env. Keep it outside the web root in production
# and point SSMS_ENV_FILE at it.

# development | production  (production forces HTTPS-only cookies and hides errors)
SSMS_ENV=development

# 32-byte random key, base64. Keys the HMAC that protects stored e-mail OTP challenges.
# Generate: php -r "echo base64_encode(random_bytes(32)),PHP_EOL;"
# Required for e-mail OTP. If it is missing, codes cannot be issued and mandatory-MFA accounts cannot sign in (fails closed).
# (Legacy TOTP secrets, if any were migrated, are also encrypted with this key: keep the old key until you purge them.)
SSMS_APP_KEY=

# --- Storage ---
# The app uses the MySQL/MariaDB database automatically when DB_HOST and DB_DATABASE are set (HostForge injects them as
# environment variables). Data, sessions and the audit log then survive redeploys. Without them it falls back to JSON files
# in data/ (local development only). Force one with SSMS_STORAGE=mysql or SSMS_STORAGE=file.
# SSMS_STORAGE=auto
# DB_HOST=
# DB_PORT=3306
# DB_DATABASE=
# DB_USERNAME=
# DB_PASSWORD=

# Session policy (minutes)
SSMS_IDLE_TIMEOUT_MIN=30
SSMS_ABSOLUTE_TIMEOUT_MIN=480

# --- MFA policy (e-mail one-time codes) ---
# sysadmin, secretary and presiding ALWAYS require an e-mailed code; this list can only ADD roles
# (valid ids: sysadmin,secretary,presiding,councilor,documentation,viewer). It can never remove those three.
SSMS_MFA_REQUIRED_ROLES=sysadmin,secretary,presiding
# Roles not listed above: "optional" (user may opt in) or "required"
SSMS_MFA_ORDINARY_POLICY=optional
# Days an ordinary account may sign in with a password only while it has no verified e-mail, when policy is "required" (0 = no grace)
SSMS_MFA_GRACE_DAYS=0

# --- E-mail OTP tuning ---
SSMS_OTP_EXPIRY_MIN=5
SSMS_OTP_MAX_ATTEMPTS=5
SSMS_OTP_RESEND_COOLDOWN_SEC=60
# Max codes e-mailed per account per 15 minutes (then sending pauses 15 min). Per-IP cap is 5x this.
SSMS_OTP_SENDS_PER_15MIN=6
# Lifetime of e-mailed verification / password links (hours)
SSMS_EMAIL_LINK_TTL_HOURS=48
# Public base URL of THIS folder, used for links inside e-mails (never taken from the Host header). No trailing slash.
SSMS_APP_URL=https://example.gov.ph/session-system

# Reject e-mail addresses whose domain does not exist / accept mail (set false only if the server has no DNS access)
SSMS_EMAIL_DNS_CHECK=true

# --- SMTP (the sender account; users' own addresses are stored per account in the app) ---
# Gmail example: host smtp.gmail.com, port 587, encryption tls, an App Password as SSMS_SMTP_PASS (needs 2-Step Verification on the sender account).
SSMS_SMTP_HOST=smtp.example.com
SSMS_SMTP_PORT=587
# tls = STARTTLS (587), ssl = implicit TLS (465), none = plaintext (only allowed to localhost, never in production)
SSMS_SMTP_ENCRYPTION=tls
SSMS_SMTP_USER=sender@example.com
SSMS_SMTP_PASS=
SSMS_MAIL_FROM=sender@example.com
SSMS_MAIL_FROM_NAME=SSMS - SP San Jose del Monte

# Geofence for QR login. Coordinates are CLIENT-REPORTED and can be spoofed (see docs).
SSMS_GEOFENCE_ENABLED=true
SSMS_OFFICE_LAT=14.81053705
SSMS_OFFICE_LNG=121.046147894731
SSMS_ALLOWED_RADIUS_METERS=300

# QR badge policy
SSMS_BADGE_ENROLL_HOURS=72
SSMS_BADGE_VALID_DAYS=180
