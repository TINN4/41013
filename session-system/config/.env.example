# Copy to config/.env (run `php tools/setup.php` to generate one with fresh secrets).
# NEVER commit config/.env. Keep it outside the web root in production
# and point SSMS_ENV_FILE at it.

# development | production  (production forces HTTPS-only cookies and hides errors)
SSMS_ENV=development

# 32-byte random key, base64. Encrypts TOTP secrets at rest and keys recovery-code hashes.
# Generate: php -r "echo base64_encode(random_bytes(32)),PHP_EOL;"
# Losing this key makes every enrolled authenticator unusable (users must re-enroll).
SSMS_APP_KEY=

# Session policy (minutes)
SSMS_IDLE_TIMEOUT_MIN=30
SSMS_ABSOLUTE_TIMEOUT_MIN=480

# MFA policy: comma-separated roles that MUST use MFA
SSMS_MFA_REQUIRED_ROLES=sysadmin,secretary,presiding
# Roles not listed above: "optional" or "required"
SSMS_MFA_ORDINARY_POLICY=optional
# Days an ordinary account has to enroll when policy is "required" (0 = immediately)
SSMS_MFA_GRACE_DAYS=0

# Geofence for QR login. Coordinates are CLIENT-REPORTED and can be spoofed (see docs).
SSMS_GEOFENCE_ENABLED=true
SSMS_OFFICE_LAT=14.81053705
SSMS_OFFICE_LNG=121.046147894731
SSMS_ALLOWED_RADIUS_METERS=300

# QR badge policy
SSMS_BADGE_ENROLL_HOURS=72
SSMS_BADGE_VALID_DAYS=180

# Optional SMTP for email OTP / password reset mail. Email OTP is NOT implemented in this build.
SSMS_SMTP_HOST=
SSMS_SMTP_USER=
SSMS_SMTP_PASS=
